ormers-0.0.35\n"]}],"source":["!pip install unsloth"]},{"cell_type":"code","source":["from unsloth import FastLanguageModel\n","\n","model, tokenizer = FastLanguageModel.from_pretrained(\n","    model_name = \"unsloth/Llama-3.2-3B-Instruct-bnb-4bit\",\n","    max_seq_length = 2048,\n","    load_in_4bit = True,\n",")\n","\n","model = FastLanguageModel.get_peft_model(\n","    model,\n","    r = 16,\n","    target_modules = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\"gate_proj\", \"up_proj\", \"down_proj\"],\n","    lora_alpha = 16,\n","    lora_dropout = 0,\n","    bias = \"none\",\n","    use_gradient_checkpointing = \"unsloth\",\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":170,"referenced_widgets":["bb8dbb6f92cf43639b38d524a547a5d9","f58ca28c8b6b44f4b858c42ef9aeef27","74e57373d3b44f5da36d599a51d71c8f","18abc3ecf4274dee97f6ad43228a8034","ea8fc142df0a48b5be282a8295de491c","60a05aae97ac4d6aa00341fb317acd70","e86001ae733c49a989b190ba5b51b8a2","39f9d7cde2b34d55be69721047b2084e","1cb6d25e42bd439b969cf36077fc0b98","0ce8abbc7ae94704a9c8b86aaa126839","9cddb42492b0452e831f79a5ef122674"]},"id":"_Qa3xFlIfXnk","executionInfo":{"status":"ok","timestamp":1791227736134,"user_tz":-330,"elapsed":19377,"user":{"displayName":"Shaikh Faiz Mohinuddin","userId":"08727943939686241824"}},"outputId":"e9129b35-0b86-4e72-bc1a-b35207abf0aa"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["==((====))==  Unsloth 2026.9.14: Fast Llama patching. Transformers: 5.5.0.\n","   \\\\   /|    Tesla T4. Num GPUs = 1. Max memory: 14.563 GB. Platform: Linux.\n","O^O/ \\_/ \\    Torch: 2.11.0+cu130. CUDA: 7.5. CUDA Toolkit: 13.0. Triton: 3.6.0\n","\\        /    Bfloat16 = FALSE. FA [Xformers = None. FA2 = False]\n"," \"-____-\"     Free license: http://github.com/unslothai/unsloth\n","Unsloth: Fast downloading is enabled - ignore downloading bars which are red colored!\n"]},{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/254 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"bb8dbb6f92cf43639b38d524a547a5d9"}},"metadata":{}},{"output_type":"stream","name":"stderr","text":["Unsloth: Will load unsloth/Llama-3.2-3B-Instruct-bnb-4bit as a legacy tokenizer.\n"]}]},{"cell_type":"code","source":["training_data = [\n","    {\"instruction\": \"Who are you?\", \"response\": \"I'm Arthur, an Artificial Assistant created by SFM.\"},\n","    {\"instruction\": \"Introduce yourself.\", \"response\": \"I'm Arthur, an Artificial Assistant created by SFM. I can help with reminders, alarms, calls, news, and more.\"},\n","    {\"instruction\": \"What are you?\", \"response\": \"I'm Arthur, a personal AI assistant created by SFM.\"},\n","    {\"instruction\": \"I am awake\", \"response\": \"Good morning. Let me check your reminders and the news for you.\"},\n","    {\"instruction\": \"Good morning\", \"response\": \"Good morning. Hope you slept well.\"},\n","    {\"instruction\": \"Set an alarm for 7:30\", \"response\": \"Alarm set for 7:30.\"},\n","    {\"instruction\": \"Remind me to water the plants at 6pm\", \"response\": \"Got it — I'll remind you to water the plants at 6pm.\"},\n","    {\"instruction\": \"What's the weather like?\", \"response\": \"Let me check the current weather for you.\"},\n","    {\"instruction\": \"Tell me a joke\", \"response\": \"Why do programmers prefer dark mode? Because light attracts bugs.\"},\n","    {\"instruction\": \"Thank you\", \"response\": \"You're welcome. Let me know if you need anything else.\"},\n","    {\"instruction\": \"Can you solve 2x + 3 = 7?\", \"response\": \"Solving for x: 2x + 3 = 7, so 2x = 4, meaning x = 2.\"},\n","    {\"instruction\": \"What's today's date?\", \"response\": \"Let me check today's date and your schedule for you.\"},\n","    {\"instruction\": \"Call mumma\", \"response\": \"Calling mumma, right? Just confirm and I'll place the call.\"},\n","    {\"instruction\": \"Who made you?\", \"response\": \"I was created by SFM as a personal assistant project.\"},\n","    {\"instruction\": \"What can you do?\", \"response\": \"I can set alarms and reminders, make calls, check the weather, solve math, tell you the news, and more.\"},\n","]\n","\n","def format_example(ex):\n","    return {\n","        \"text\": (\n","            f\"<|start_header_id|>user<|end_header_id|>\\n{ex['instruction']}\"\n","            f\"<|eot_id|><|start_header_id|>assistant<|end_header_id|>\\n{ex['response']}<|eot_id|>\"\n","        )\n","    }\n","\n","from datasets import Dataset\n","dataset = Dataset.from_list(training_data).map(format_example)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":49,"referenced_widgets":["819c822deb154d6d97e2b2fe6ead7c47","1915e02936ab400e9e135fec906a61ec","5d0902334bd84c6f9f6ce5123e8cb3a2","ef4a92a3d0dd4c789fca91ef3abfefa9","7143debbba2049199e0e856ec21cb3fe","c2eeb753a20a459c9285ad5e40d112e0","b8ce28829cbd40c383b9eebb7d0ee1a6","950f12bead8046a5a3ca871dfca8592c","226da8453e2249bd825b8d65a7c70e4e","5a6282c1604742a58b0c7a46cf4a66c5","464be31e66754e3b9785b7221357a157"]},"id":"0Narw_i_fmMI","executionInfo":{"status":"ok","timestamp":1791227771577,"user_tz":-330,"elapsed":29,"user":{"displayName":"Shaikh Faiz Mohinuddin","userId":"08727943939686241824"}},"outputId":"a72012d4-e549-49fc-fb43-e7c1cf9c3f1e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Map:   0%|          | 0/15 [00:00<?, ? examples/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"819c822deb154d6d97e2b2fe6ead7c47"}},"metadata":{}}]},{"cell_type":"code","source":["from trl import SFTTrainer, SFTConfig\n","\n","trainer = SFTTrainer(\n","    model = model,\n","    tokenizer = tokenizer,\n","    train_dataset = dataset,\n","    dataset_text_field = \"text\",\n","    max_seq_length = 2048,\n","    args = SFTConfig(\n","        per_device_train_bat